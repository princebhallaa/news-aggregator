# Copy this file to ".env" in the same folder and fill in your real keys.
# Never commit the real .env file to git.

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/apis/credentials  (enable "YouTube Data API v3")
YOUTUBE_API_KEY=

# --- Telegram (my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=news_aggregator_session

# --- Database ---
# Default: local SQLite file, zero setup needed.
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/news_aggregator
DATABASE_URL=sqlite:///./news_aggregator.db

# --- Misc ---
CACHE_TTL_MINUTES=15
MAX_RESULTS_PER_PLATFORM=15
FRONTEND_ORIGIN=http://127.0.0.1:5500
